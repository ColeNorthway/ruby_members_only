<%= form_with model: @user, url: user_path, method: @user.new_record? ? :post : :patch do |form| %>
  Username: <%= form.text_field :username, required: true %><br><br>
  <% unless @user.new_record? %>
    Current Password: <%= form.password_field :password_challenge, required: true %><br>
  <% end %>
  Password: <%= form.password_field :password, required: true %><br>
  Confirm Password: <%= form.password_field :password_confirmation, required: true %><br>
  <%= form.submit %>
<% end %>
<% unless @user.new_record? %>
  <%= button_to "Delete Account", @user, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
<% end %>