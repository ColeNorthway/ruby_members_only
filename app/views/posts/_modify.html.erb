<%# Show errors on fail to create %>
<% if @post.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@post.errors.count, "error") %> prohibited this post from being saved:</h2>
    <ul>
      <% @post.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @post do |form| %>
  Title: <%= form.text_field :title, required: true %><br>
  Body: <%= form.textarea :body, size: "70x5", required: true %><br><br>
  <%= form.submit %>
<% end %>