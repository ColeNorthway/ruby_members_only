<% if @logged_in && !@user.nil? %>
  <h1 id="clubhouse-title">Hi <%= @user.username %>, Welcome to the Secret Clubhouse</h1>
<% else %>
  <h1 id="clubhouse-title">Secret Clubhouse</h1>
<% end %>
<%= render @posts %>

<br><br>
<% if @logged_in %>
  <%= link_to "New Post", new_post_path %>
<% end %>
<%= link_to "Signup", new_user_path %>
<%= link_to "Login", new_session_path %>
<% if @logged_in %>
  <%= button_to "Logout", '/session', method: 'delete', data: { turbo_confirm: 'Do you want to logout?' } %>
  <%= link_to "My Profile", user_path %>
<% end %>
